# Copy this file to .env and fill in the values. Never commit .env.

PORT=8080
# Allowed web origins, comma separated ("*" = any)
CORS_ORIGIN=*
# Public address of this backend, used in uploaded image URLs (GET /files/:id).
# Leave empty locally; set it when deployed, e.g. https://api.your-domain.com
# PUBLIC_URL=
# Max size of an uploaded image (the web app shrinks photos before sending)
MAX_IMAGE_MB=5

# Google Gemini (chat assistant + trip generation)
# Free key: https://aistudio.google.com/apikey
# MODEL_NAME: a Flash model. MODEL_FALLBACKS: tried in order when it is
# overloaded / out of quota / retired (common on the free tier).
# Models your key can use: https://ai.google.dev/gemini-api/docs/models
API_KEY_CHAT=your-gemini-api-key
MODEL_NAME=gemini-3.5-flash
MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash

# HERE API (coordinates of the places in a saved plan)
HERE_API_KEY=your-here-api-key

# MongoDB Atlas
MONGODB_USERNAME="your-db-user"
MONGODB_PASSWORD="your-db-password"
MONGODB_URI="mongodb+srv://your-db-user:your-db-password@your-cluster.mongodb.net"
# Optional: database name (defaults to the one in the URI, or "test")
# MONGODB_DB_NAME=aloca

# Gmail account that sends verification codes (use an App Password)
USERNAME_MAIL=your-email@gmail.com
PASSWORD_MAIL=your-app-password

# JWT secrets: long random strings
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me-too

# npm run seed -> creates / updates this admin account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# npm run seed:sample -> password of the demo accounts (defaults to demo123 outside production)
# SEED_DEMO_PASSWORD=demo123
