{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {"@/*": ["../../web/src/*"]},
    "types": ["cypress", "@testing-library/cypress", "node", "vite/client"]
  },
  "include": ["cypress", "cypress.config.ts", "vite.config.ts"]
}
